{
  "name": "portus-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js",
    "test": "node --test test/*.test.js",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:launch-sandbox": "RUN_LAUNCH_SANDBOX=1 node --test test/launch-sandbox.test.js",
    "validate:structure": "node validate-structure.js",
    "generate:sitemap": "node scripts/generate-sitemap.js"
  },
  "dependencies": {
    "@paypal/checkout-server-sdk": "^1.0.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^18.0.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "resend": "^6.32.1",
    "stripe": "^23.0.0"
  },
  "overrides": {
    "qs": "^6.16.0",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    }
  },
  "devDependencies": {
    "jest": "^30.5.1"
  }
}
